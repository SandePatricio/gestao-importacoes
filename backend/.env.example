# Copiar para .env e ajustar os valores
DATABASE_URL=mysql+pymysql://root@localhost:3306/gestao_importacoes
SECRET_KEY=alterar-para-uma-chave-secreta-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cálculo do frete aéreo
# valor a pagar = peso cobrável (maior entre peso real e volumétrico) × tarifa
# peso volumétrico = (C × L × A em cm) / divisor
TARIFA_POR_KG=1800
DIVISOR_VOLUMETRICO=6000

# ISPC (empresa em Imposto Simplificado p/ Pequenos Contribuintes — não cobra IVA)
# Método: PROGRESSIVA (3/4/5% por escalão), FIXA (percentagem única) ou QUOTA (valor anual)
ISPC_METODO=PROGRESSIVA
ISPC_PERCENTAGEM=3
ISPC_QUOTA_ANUAL=75000
ISPC_PRIMEIRO_ANO=False

# Multa por atraso no pagamento do frete (após disponibilidade em Maputo)
# multa = (dias além da tolerância) × MULTA_VALOR_DIA
MULTA_VALOR_DIA=200
MULTA_DIAS_TOLERANCIA=3

# API externa de tracking (17TRACK, AfterShip ou TrackingMore)
TRACKING_API_PROVIDER=17track
TRACKING_API_KEY=
TRACKING_API_BASE_URL=https://api.17track.net/track/v2.2
TRACKING_SYNC_INTERVAL_MINUTES=30

# Notificações por e-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@conneximportacoes.co.mz
